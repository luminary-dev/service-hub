{
  "name": "identity-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:migrate": "prisma migrate deploy && exec node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "create-admin": "node --env-file-if-exists=.env prisma/create-admin.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "^10.69.0",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.18",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@hono/node-server": "^2.1.11",
    "effect": "^3.22.5",
    "rimraf": "^6.1.4",
    "fast-uri": "^3.1.9",
    "source-map-js": "^1.2.2"
  }
}
